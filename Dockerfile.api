FROM node:20-slim AS frontend
WORKDIR /build
COPY dashboard/package*.json ./
RUN npm install
COPY dashboard/ ./
RUN npm run build

FROM python:3.11-slim
WORKDIR /opt/orca
RUN pip install fastapi uvicorn websockets anthropic openai pydantic pyyaml --no-cache-dir
COPY agent/ ./agent/
COPY api/ ./api/
COPY intents/ ./intents/
COPY --from=frontend /build/dist ./dashboard/dist
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
