# LLM substrate. anthropic = Claude Sonnet, nim = NVIDIA Nemotron via integrate.api.nvidia.com
LLM_PROVIDER=anthropic
# Override the default model id for the chosen provider.
#   anthropic default: claude-sonnet-4-20250514
#   nim default:       nvidia/nvidia-nemotron-3-super-120b
LLM_MODEL=
# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Required when LLM_PROVIDER=nim
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional NIM endpoint override (defaults to integrate.api.nvidia.com/v1)
NVIDIA_BASE_URL=
DB_PATH=/data/orca.db
NETWORK_ADAPTER=containerlab
AGENT_POLL_INTERVAL=15
SMTP_USER=your_email@gmail.com
OPS_EMAIL=your_email@gmail.com
SENDGRID_API_KEY=your_sendgrid_key_here
